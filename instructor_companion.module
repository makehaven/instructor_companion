<?php

/**
 * @file
 * Primary module hooks for Instructor Companion.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\node\Entity\Node;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\HtmlCommand;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_cron().
 */
function instructor_companion_cron() {
  // Sync all course stats once a day or on a schedule.
  \Drupal::service('instructor_companion.stats_sync')->sync();
  \Drupal::service('instructor_companion.badge_sync')->sync();
  // Nudge instructors who still have post-class tasks ~48h after the class.
  \Drupal::service('instructor_companion.post_event_reminder')->run();
  // Weekly digest to staff of interest/proposal submissions stuck unreviewed.
  \Drupal::service('instructor_companion.stale_review_nudge')->run();
}

/**
 * Implements hook_entity_insert().
 *
 * Posts Slack notifications for new Workshop Proposal / Instructor Interest
 * submissions so staff see the backlog. Handled webforms are listed in
 * ProposalNotifier::HANDLED_WEBFORMS.
 */
function instructor_companion_entity_insert(EntityInterface $entity) {
  if ($entity instanceof WebformSubmissionInterface) {
    \Drupal::service('instructor_companion.proposal_notifier')
      ->notifyForSubmission($entity);
  }
  _instructor_companion_maybe_release_holds($entity);
}

/**
 * Implements hook_entity_update().
 */
function instructor_companion_entity_update(EntityInterface $entity) {
  _instructor_companion_maybe_release_holds($entity);
}

/**
 * Releases held proposals when an orientation badge request becomes active.
 *
 * The other onboarding completion point (agreement signing) triggers its own
 * release in InstructorAgreementHandler. ProposalHoldManager::releaseFor()
 * no-ops cheaply unless the user actually has held events and is onboarded,
 * so calling it for every active badge_request save is fine.
 */
function _instructor_companion_maybe_release_holds(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'badge_request') {
    return;
  }
  if (!$entity->hasField('field_badge_status') || $entity->get('field_badge_status')->value !== 'active') {
    return;
  }
  if (!$entity->hasField('field_member_to_badge') || $entity->get('field_member_to_badge')->isEmpty()) {
    return;
  }
  $uid = (int) $entity->get('field_member_to_badge')->target_id;
  if ($uid > 0) {
    \Drupal::service('instructor_companion.proposal_hold_manager')->releaseFor($uid);
  }
}

/**
 * Implements hook_civicrm_event_insert().
 */
function instructor_companion_civicrm_event_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  // Proposal-flow events (URL ?propose=1) get flipped to is_active=0 *after*
  // this insert transaction commits — see the kernel.terminate subscriber in
  // \Drupal\instructor_companion\EventSubscriber\ProposalDeactivateSubscriber.
  // Trying to update the row from inside this hook deadlocks against the
  // entity save's own transaction; CiviCRM Entity also re-syncs the field
  // back to its own default.
  $request = \Drupal::request();
  if (($request->query->get('propose') ?? '') === '1'
      && $entity->hasField('is_active')
      && (int) $entity->get('is_active')->value === 1) {
    \Drupal::state()->set(
      'instructor_companion.proposal_deactivate_queue',
      array_merge(
        (array) \Drupal::state()->get('instructor_companion.proposal_deactivate_queue', []),
        [(int) $entity->id()]
      )
    );
  }

  // A proposal is an inactive event saved by a user who cannot manage events
  // themselves. Staff also save events as inactive (drafts), so `!is_active`
  // alone is not a sufficient signal — it caused false "New Session Proposal"
  // emails to Education when staff saved an event with Is Active = No.
  // Use the broad CiviCRM `edit all events` permission: anyone who holds it
  // (administrator / manager / event_management / special) is staff and not
  // a proposer; absence of it indicates an instructor-class user.
  $is_proposal = !$entity->get('is_active')->value
    && !\Drupal::currentUser()->hasPermission('edit all events')
    && $entity->hasField('field_parent_course')
    && !$entity->get('field_parent_course')->isEmpty();
  if ($is_proposal) {
    $mailManager = \Drupal::service('plugin.manager.mail');
    $module = 'instructor_companion';
    $key = 'new_proposal_submitted';
    $config = \Drupal::config('instructor_companion.settings');
    $to = $config->get('notification_email') ?: \Drupal::config('system.site')->get('mail');
    
    $params['event_title'] = $entity->label();
    $params['event_link'] = $entity->toUrl('edit-form', ['absolute' => TRUE])->toString();
    $params['user_name'] = \Drupal::currentUser()->getDisplayName();
    
    $mailManager->mail($module, $key, $to, 'en', $params, NULL, TRUE);
    \Drupal::messenger()->addMessage(t('Your proposal has been submitted for staff review.'));
  }

  // Trigger sync for the parent course.
  if ($entity->hasField('field_parent_course') && !$entity->get('field_parent_course')->isEmpty()) {
    $nid = (int) $entity->get('field_parent_course')->target_id;
    \Drupal::service('instructor_companion.stats_sync')->sync($nid);
    \Drupal::service('instructor_companion.badge_sync')->sync($nid);
  }
}


/**
 * Implements hook_ENTITY_TYPE_create_access() for civicrm_event.
 *
 * Allows members and instructors to create a CiviCRM event only when they're
 * coming through the proposal flow (?propose=1 in the URL). Without this, the
 * "Propose to Teach" button on /become-instructor/courses 403s because those
 * roles don't hold the broad `edit all events` permission.
 *
 * Proposal-first funnel: proposing does NOT require onboarding or staff
 * approval of the person — every proposal is individually staff-reviewed, and
 * approval of a proposal from a not-yet-onboarded instructor is held until
 * they finish onboarding (see ProposalHoldManager). The form-alter at
 * instructor_companion_form_civicrm_event_civicrm_event_add_form_alter still
 * constrains what proposers can do (is_active forced off, instructor field
 * defaulted to themselves).
 */
function instructor_companion_civicrm_event_create_access(\Drupal\Core\Session\AccountInterface $account, array $context, $entity_bundle) {
  if (!array_intersect(['member', 'instructor'], $account->getRoles())) {
    return \Drupal\Core\Access\AccessResult::neutral();
  }
  $is_proposal = (\Drupal::request()->query->get('propose') ?? '') === '1';
  if (!$is_proposal) {
    return \Drupal\Core\Access\AccessResult::neutral();
  }
  return \Drupal\Core\Access\AccessResult::allowed()
    ->cachePerUser()
    ->addCacheContexts(['url.query_args:propose']);
}

/**
 * Implements hook_civicrm_event_update().
 */
function instructor_companion_civicrm_event_update(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->hasField('field_parent_course') && !$entity->get('field_parent_course')->isEmpty()) {
    $nid = (int) $entity->get('field_parent_course')->target_id;
    \Drupal::service('instructor_companion.stats_sync')->sync($nid);
    \Drupal::service('instructor_companion.badge_sync')->sync($nid);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 */
function instructor_companion_form_user_register_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $query = \Drupal::request()->query;
  if ($query->get('profile') === 'instructor') {
    $form['actions']['submit']['#submit'][] = 'instructor_companion_user_register_notify';
  }
}

/**
 * Custom submit handler: Notify staff of new instructor applicant.
 */
function instructor_companion_user_register_notify($form, FormStateInterface $form_state) {
  $user = $form_state->getFormObject()->getEntity();
  $mailManager = \Drupal::service('plugin.manager.mail');
  $module = 'instructor_companion';
  $key = 'new_instructor_applicant';
  $config = \Drupal::config('instructor_companion.settings');
  $to = $config->get('notification_email') ?: \Drupal::config('system.site')->get('mail');
  $params['user_name'] = $user->getAccountName();
  $params['user_email'] = $user->getEmail();
  $params['user_link'] = $user->toUrl()->setAbsolute()->toString();
  $langcode = $user->getPreferredLangcode();
  $mailManager->mail($module, $key, $to, $langcode, $params, NULL, TRUE);

  // Send the configurable welcome email to the instructor themselves, if
  // enabled and an email is on file.
  if ($config->get('instructor_welcome_enabled') && $user->getEmail()) {
    $mailManager->mail(
      $module,
      'instructor_welcome',
      $user->getEmail(),
      $langcode,
      ['user' => $user],
      NULL,
      TRUE,
    );
  }

  \Drupal::messenger()->addMessage(t('Your instructor application has been started. Please sign the instructor agreement on the next page so staff can review and follow up.'));
}

/**
 * Implements hook_mail().
 */
function instructor_companion_mail($key, &$message, $params) {
  switch ($key) {
    case 'new_instructor_applicant':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('New Instructor Application: @name', ['@name' => $params['user_name']]);
      $message['body'][] = t('A new user has registered via the Instructor path.');
      $message['body'][] = t('Name: @name', ['@name' => $params['user_name']]);
      $message['body'][] = t('Email: @email', ['@email' => $params['user_email']]);
      $message['body'][] = t('Profile: @link', ['@link' => $params['user_link']]);
      $message['body'][] = t('Please review their application and assign the Instructor role if approved.');
      break;

    case 'instructor_welcome':
      $config = \Drupal::config('instructor_companion.settings');
      $token = \Drupal::token();
      $data = ['user' => $params['user']];
      $options = ['clear' => TRUE];
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = $token->replace($config->get('instructor_welcome_subject'), $data, $options);
      $message['body'][] = $token->replace($config->get('instructor_welcome_body'), $data, $options);
      break;

    case 'interest_approval':
      // Subject and body are passed in pre-rendered by ProposalProcessor
      // (token replacement happens there because the submitter may not be a
      // Drupal user, so [user:*] tokens don't apply and we use direct
      // [submission:*] substitution).
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['body'];
      break;

    case 'new_proposal_submitted':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('New Session Proposal: @title', ['@title' => $params['event_title']]);
      $message['body'][] = t('An instructor has proposed a new session.');
      $message['body'][] = t('Course: @title', ['@title' => $params['event_title']]);
      $message['body'][] = t('Instructor: @name', ['@name' => $params['user_name']]);
      $message['body'][] = t('Review Proposal: @link', ['@link' => $params['event_link']]);
      break;

    case 'instructor_agreement_signed':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Instructor Agreement Signed: @name', ['@name' => $params['user_name']]);
      $message['body'][] = t('A member has signed the base instructor agreement and is awaiting approval.');
      $message['body'][] = t('Name: @name', ['@name' => $params['user_name']]);
      $message['body'][] = t('Email: @email', ['@email' => $params['user_email']]);
      $message['body'][] = t('User profile: @link', ['@link' => $params['user_link']]);
      $message['body'][] = t('Next step: review their background and assign the Instructor role when ready. Reply to this email or contact them directly to discuss their first class.');
      if (!empty($params['needs_door_review'])) {
        $queue_url = \Drupal\Core\Url::fromRoute('instructor_companion.prospective_instructors', [], ['absolute' => TRUE])->toString();
        $message['body'][] = t('Door access: this instructor does NOT already have a building door badge. A pending request was created — review their background and approve building access at: @link', ['@link' => $queue_url]);
      }
      break;

    case 'proposal_approved':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Your session proposal has been approved: @title', ['@title' => $params['event_title']]);
      $message['body'][] = t('Hi @name,', ['@name' => $params['user_name']]);
      $message['body'][] = t('Great news — your proposed session has been approved and is now live on the MakeHaven calendar!');
      $message['body'][] = t('Session: @title', ['@title' => $params['event_title']]);
      if (!empty($params['start_date'])) {
        $message['body'][] = t('Date: @date', ['@date' => $params['start_date']]);
      }
      if (!empty($params['event_link'])) {
        $message['body'][] = t('View your session: @link', ['@link' => $params['event_link']]);
      }
      $message['body'][] = t('Please log into your Instructor Dashboard to review enrollment, request payment, and submit post-class feedback. If you have any questions, reply to this email.');
      $message['body'][] = t('Thank you for teaching at MakeHaven!');
      break;

    case 'proposal_approved_pending_onboarding':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Approved! Two quick steps before "@title" goes live', ['@title' => $params['event_title']]);
      $message['body'][] = t('Hi @name,', ['@name' => $params['user_name']]);
      $message['body'][] = t('Great news — staff approved your proposed session "@title".', ['@title' => $params['event_title']]);
      if (!empty($params['start_date'])) {
        $message['body'][] = t('Date: @date', ['@date' => $params['start_date']]);
      }
      $message['body'][] = t('Before it is published on the MakeHaven calendar, please finish instructor onboarding (about 10 minutes total):');
      foreach ((array) $params['outstanding'] as $item) {
        $message['body'][] = '  • ' . $item;
      }
      $message['body'][] = t('As soon as both are done, your session goes live automatically and we will email you a confirmation.');
      $message['body'][] = t('Questions? Reply to this email or contact education@makehaven.org.');
      break;

    case 'held_proposal_released':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Held session(s) now live: @name completed onboarding', ['@name' => $params['user_name']]);
      $message['body'][] = t('@name finished instructor onboarding (orientation quiz + signed agreement). Their approved session(s) were published automatically:', ['@name' => $params['user_name']]);
      foreach ((array) $params['released_titles'] as $title) {
        $message['body'][] = '  • ' . $title;
      }
      $message['body'][] = t('No action needed — this is a confirmation.');
      break;

    case 'stale_review_nudge':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('@n instructor submission(s) waiting on review', ['@n' => $params['total']]);
      $message['body'][] = t('These submissions are more than a week old and have no Review Status yet. Setting a status in the queue is what triggers the automated follow-up (next-steps email, course creation) — replying to the original notification does not.');
      if (!empty($params['console_url'])) {
        $message['body'][] = t('Everything below (and the rest of the instructor pipeline) is on the Education Console: @url', ['@url' => $params['console_url']]);
      }
      foreach ((array) $params['sections'] as $section) {
        $message['body'][] = '';
        $message['body'][] = t('@label: @count unreviewed (oldest @oldest)', [
          '@label' => $section['label'],
          '@count' => $section['count'],
          '@oldest' => $section['oldest'],
        ]);
        $message['body'][] = t('Review queue: @url', ['@url' => $section['queue_url']]);
      }
      break;

    case 'proposal_denied':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Update on your session proposal: @title', ['@title' => $params['event_title']]);
      $message['body'][] = t('Hi @name,', ['@name' => $params['user_name']]);
      $message['body'][] = t('Thank you for submitting a session proposal. After review, we are not able to move forward with this particular proposal at this time.');
      $message['body'][] = t('Session: @title', ['@title' => $params['event_title']]);
      $message['body'][] = t('Reason:');
      $message['body'][] = $params['reason'];
      $message['body'][] = t('We encourage you to reach out if you have questions or would like to discuss other teaching opportunities. You can reply directly to this email or contact education@makehaven.org.');
      break;

    case 'class_checkout_quiz_reminder':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Last step for your @badge badge: video + quiz', ['@badge' => $params['badge_label']]);
      $message['body'][] = t('Hi @name,', ['@name' => $params['student_name']]);
      $message['body'][] = t('Thanks for completing the @event class. The instructor has signed off on your in-person portion.', [
        '@event' => $params['event_label'],
      ]);
      $message['body'][] = t('Your @badge badge will become active once you have also watched the video and passed the quiz at 100%.', [
        '@badge' => $params['badge_label'],
      ]);
      $message['body'][] = t('Take the quiz: @url', ['@url' => $params['quiz_url']]);
      $message['body'][] = t('If you have any questions, reply to this email or contact education@makehaven.org.');
      break;

    case 'post_event_reminder':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('A few wrap-up tasks left for @event', ['@event' => $params['event_label']]);
      $message['body'][] = t('Hi @name,', ['@name' => $params['instructor_name']]);
      $message['body'][] = t('Thanks for teaching @event! A couple of post-class tasks are still open:', [
        '@event' => $params['event_label'],
      ]);
      foreach ((array) $params['outstanding'] as $item) {
        $message['body'][] = '  • ' . $item;
      }
      $message['body'][] = t('Knock them all out in one place here: @url', ['@url' => $params['hub_url']]);
      $message['body'][] = t('This includes taking attendance, approving badges, submitting feedback and the materials you need reordered, and requesting payment for your hours.');
      $message['body'][] = t('Questions? Reply to this email or contact education@makehaven.org.');
      break;
  }
}

/**
 * Implements hook_entity_extra_field_info().
 *
 * Declares "Schedule new instance" as a configurable display component on
 * the course content type. Admins can hide / reposition it via Manage
 * Display. Default-on so it's visible without any setup post-deploy.
 */
/**
 * Renders the "teach this workshop" call-to-action on a course page.
 *
 * A course page was a dead end for anyone who read it and thought they could
 * run it: the sidebar offered "get notified when this is scheduled" and
 * nothing else. The next step differs by reader, so the wording does too —
 * a member can propose this exact course and land on a pre-filled form, while
 * someone with no account has to start with the interest form.
 */
function _instructor_companion_teach_this_cta(array &$build, EntityInterface $entity, $display): void {
  if (!$display->getComponent('teach_this_course')) {
    return;
  }

  // Meetups are hosted, not taught for pay — offering to teach one is exactly
  // the mix-up this module removed from the course picker.
  if ($entity->hasField('field_course_type')
    && $entity->get('field_course_type')->value === 'meetup') {
    return;
  }

  $account = \Drupal::currentUser();
  $roles = $account->getRoles();

  if (in_array('instructor', $roles, TRUE) || in_array('member', $roles, TRUE)) {
    $title = t('Propose to teach this');
    $body = t('Pick a date and we will take it from there. Staff review every proposal.');
    $url = \Drupal\Core\Url::fromUserInput('/civicrm-event/add', [
      'query' => ['course_id' => $entity->id(), 'propose' => 1],
    ]);
  }
  else {
    $title = t('Could you teach this?');
    $body = t('We are always looking for instructors. Tell us a bit about yourself and the education team will be in touch.');
    $url = \Drupal\Core\Url::fromUserInput('/instructor');
  }

  $build['teach_this_course'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['course-teach-cta']],
    'heading' => ['#markup' => '<h3>' . $title . '</h3>'],
    'body' => ['#markup' => '<p>' . $body . '</p>'],
    'link' => [
      '#type' => 'link',
      '#title' => in_array('member', $roles, TRUE) || in_array('instructor', $roles, TRUE)
        ? t('Propose a date')
        : t('Register your interest'),
      '#url' => $url,
      '#attributes' => ['class' => ['button', 'button--primary']],
    ],
    // Anonymous and member readers see different copy, so the render cache has
    // to vary by role or the first visitor's version is served to everyone.
    '#cache' => [
      'contexts' => ['user.roles'],
      'tags' => $entity->getCacheTags(),
    ],
  ];
}

function instructor_companion_entity_extra_field_info() {
  return [
    'node' => [
      'course' => [
        'display' => [
          'schedule_instance_button' => [
            'label' => t('Schedule new instance button'),
            'description' => t('Admin button for staff to clone the linked CiviCRM template into a new event.'),
            'weight' => -10,
            'visible' => TRUE,
          ],
          'teach_this_course' => [
            'label' => t('Teach this workshop call-to-action'),
            'description' => t('Invites the reader to teach this workshop. Wording and destination depend on whether they are signed in and a member.'),
            'weight' => -9,
            'visible' => TRUE,
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * Renders the schedule_instance_button pseudo-field into $build['content'],
 * which is what node templates actually output. Permission-gated and
 * theme-agnostic.
 */
function instructor_companion_node_view(array &$build, EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->bundle() !== 'course') {
    return;
  }

  _instructor_companion_teach_this_cta($build, $entity, $display);
  if (!$display->getComponent('schedule_instance_button')) {
    return;
  }
  if (!\Drupal::currentUser()->hasPermission('edit all events')) {
    return;
  }

  $template_id = $entity->hasField('field_civicrm_template_id') && !$entity->get('field_civicrm_template_id')->isEmpty()
    ? (int) $entity->get('field_civicrm_template_id')->value
    : NULL;

  if ($template_id) {
    $build['schedule_instance_button'] = [
      '#type' => 'link',
      '#title' => t('Schedule New Instance'),
      '#url' => \Drupal\Core\Url::fromRoute('instructor_companion.schedule_instance', [
        'node' => $entity->id(),
      ]),
      '#attributes' => [
        'class' => ['button', 'button--primary', 'button--action'],
        'title' => t('Clones template @id (with reminders, fees, profiles) into a new event and opens the edit form.', ['@id' => $template_id]),
      ],
      '#cache' => [
        'contexts' => ['user.permissions'],
        'tags' => $entity->getCacheTags(),
      ],
    ];
  }
  else {
    $build['schedule_instance_button'] = [
      '#type' => 'link',
      '#title' => t('Configure CiviCRM Template to enable scheduling'),
      '#url' => \Drupal\Core\Url::fromRoute('entity.node.edit_form', ['node' => $entity->id()], [
        'fragment' => 'edit-field-civicrm-template-id-0-value',
      ]),
      '#attributes' => [
        'class' => ['button', 'button--secondary'],
      ],
      '#cache' => [
        'contexts' => ['user.permissions'],
        'tags' => $entity->getCacheTags(),
      ],
    ];
  }
}

/**
 * Returns badge terms for which the given user is not yet an approved badger.
 *
 * Being a badger (badge issuer) means the user appears in field_badge_issuer
 * on the badge taxonomy term. That status is granted by staff after the full
 * process: earn the badge → shadow a badger → run a supervised session → staff
 * approval. Simply holding an active badge_request is not sufficient.
 *
 * @param \Drupal\taxonomy\TermInterface[] $badge_terms
 * @param int $uid
 * @return string[] Labels of badges for which the user is not yet a badger.
 */
function instructor_companion_missing_badges(array $badge_terms, int $uid): array {
  if (empty($badge_terms) || !$uid) {
    return [];
  }
  $missing = [];
  foreach ($badge_terms as $badge) {
    $issuer_uids = array_map(
      'intval',
      array_column($badge->get('field_badge_issuer')->getValue(), 'target_id')
    );
    if (!in_array($uid, $issuer_uids, TRUE)) {
      $missing[] = $badge->label();
    }
  }
  return $missing;
}

/**
 * Adds a badge prerequisite warning element to a form.
 *
 * @param array $form
 * @param string[] $missing_badges
 */
function instructor_companion_add_badge_warning(array &$form, array $missing_badges): void {
  $list = implode(', ', array_map(fn($b) => "<strong>$b</strong>", $missing_badges));
  $form['badge_prerequisite_warning'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['messages', 'messages--warning']],
    '#weight' => -20,
    'message' => [
      '#markup' => t(
        'This class awards the following badge(s): !badges. Before teaching it, you\'ll need to become an approved badger for each one. The process is: (1) earn the badge, (2) shadow an existing badger, (3) run a session under supervision, then (4) staff will grant you badger status. Contact education@makehaven.org to get started.',
        ['!badges' => $list]
      ),
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for civicrm_event_civicrm_event_add_form.
 *
 * Two flows reach this form:
 *
 * 1. Instructor proposal (?course_id=X&propose=1) from CoursePickerController
 *    at /become-instructor/courses. The instructor fills the form fresh; we
 *    shallow-prefill from the course node and the CiviCRM template (title,
 *    type, max participants, etc.) so they don't start from zero. This path
 *    creates a brand-new draft event — reminders/price-set/profiles are NOT
 *    cloned because that would surprise the instructor with template state
 *    they can't see.
 *
 * 2. (Removed) Staff "Schedule This Course" — that flow now goes through
 *    ScheduleInstanceController, which uses CRM_Event_BAO_Event::copy() to
 *    do a deep clone of the template (reminders, price set, profiles) and
 *    redirects straight to the new event's edit form. Don't route staff
 *    scheduling through here; the shallow prefill loses reminders.
 */
function instructor_companion_form_civicrm_event_civicrm_event_add_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $query = \Drupal::request()->query;
  $template_id = $query->get('template_id');
  $course_id = $query->get('course_id');
  $is_proposal = $query->get('propose');

  // Proposing from the course picker arrives with course_id but no
  // template_id, so the form opened almost empty — the proposer retyped a
  // title, description and capacity that the course has run with nine times
  // before. The copy-from-template machinery below already does exactly what
  // is wanted; it just had nothing to copy from. Fall back to the course's
  // most recent published session so the form opens pre-filled and the
  // proposer edits rather than authors.
  if (!$template_id && $course_id) {
    $database = \Drupal::database();
    if ($database->schema()->tableExists('civicrm_event__field_parent_course')) {
      $last = $database->select('civicrm_event__field_parent_course', 'f');
      $last->join('civicrm_event', 'e', 'e.id = f.entity_id');
      $last->fields('e', ['id']);
      $last->condition('f.field_parent_course_target_id', $course_id);
      $last->condition('e.is_active', 1);
      $last->orderBy('e.start_date', 'DESC');
      $last->range(0, 1);
      $template_id = $last->execute()->fetchField() ?: NULL;
    }
  }

  if ($course_id) {
    $course_node = Node::load($course_id);
    if ($course_node && isset($form['field_parent_course'])) {
      $form['field_parent_course']['widget'][0]['target_id']['#default_value'] = $course_node;
    }
    
    if ($course_node) {
      // 1. Fetch and Display Past Instructors. `users_field_data` doesn't
      // carry a `display_name` column in this version; the display name is
      // computed via the entity's getDisplayName(). Pull just `name` and the
      // uid, then load the User entity to ask for the display name.
      $database = \Drupal::database();
      $q = $database->select('civicrm_event__field_civi_event_instructor', 'i');
      $q->join('civicrm_event__field_parent_course', 'f', 'i.entity_id = f.entity_id');
      $q->join('civicrm_event', 'e', 'e.id = i.entity_id');
      $q->join('users_field_data', 'u', 'u.uid = i.field_civi_event_instructor_target_id');
      $q->fields('u', ['uid', 'name']);
      $q->addExpression('MAX(e.start_date)', 'last_taught');
      $q->condition('f.field_parent_course_target_id', $course_id);
      $q->condition('e.is_active', 1);
      $q->groupBy('u.uid');
      $q->groupBy('u.name');
      $q->orderBy('last_taught', 'DESC');
      $instructors = $q->execute()->fetchAll();

      if (!empty($instructors)) {
        $instr_list = [];
        $uids = array_map(fn($r) => (int) $r->uid, $instructors);
        $user_storage = \Drupal::entityTypeManager()->getStorage('user');
        $users = $user_storage->loadMultiple($uids);
        foreach ($instructors as $instr) {
          $u = $users[(int) $instr->uid] ?? NULL;
          $display = $u ? (string) $u->getDisplayName() : $instr->name;
          $date = date('M Y', strtotime($instr->last_taught));
          $instr_list[] = "{$display} (Last: $date)";
        }
        if (isset($form['field_civi_event_instructor'])) {
          $form['field_civi_event_instructor']['widget']['#description'] = Markup::create(
            '<strong>Past Instructors:</strong> ' . implode(', ', $instr_list)
          );
        }
      }

      // 2. Asset Checking logic with AJAX.
      $required_assets = $course_node->get('field_required_assets')->referencedEntities();
      if (!empty($required_assets)) {
        $asset_names = array_map(fn($a) => $a->getTitle(), $required_assets);
        $asset_ids = array_map(fn($a) => $a->id(), $required_assets);
        
        $form['asset_info'] = [
          '#type' => 'details',
          '#title' => t('Required Assets Check'),
          '#open' => TRUE,
          '#weight' => -5,
          '#attributes' => ['id' => 'asset-check-wrapper'],
          'message' => [
            '#markup' => '<p>This course requires: <strong>' . implode(', ', $asset_names) . '</strong></p>',
          ],
          'conflict_warning' => [
            '#markup' => '<div id="asset-conflict-warning"><em>Select a date/time to check for tool conflicts.</em></div>',
          ],
        ];

        $form['required_asset_ids'] = [
          '#type' => 'hidden',
          '#value' => implode(',', $asset_ids),
        ];

        if (isset($form['start_date'])) {
          $form['start_date']['widget'][0]['value']['#ajax'] = [
            'callback' => 'instructor_companion_check_conflicts_ajax',
            'wrapper' => 'asset-conflict-warning',
            'event' => 'change',
          ];
        }
        if (isset($form['end_date'])) {
          $form['end_date']['widget'][0]['value']['#ajax'] = [
            'callback' => 'instructor_companion_check_conflicts_ajax',
            'wrapper' => 'asset-conflict-warning',
            'event' => 'change',
          ];
        }
        if ($is_proposal) {
          $form['#validate'][] = 'instructor_companion_validate_proposal_asset_conflicts';
        }
      }

      if ($is_proposal) {
        $form['#title'] = t('Propose a Session: @course', ['@course' => $course_node->label()]);
        if (isset($form['is_active'])) {
          $form['is_active']['widget']['#default_value'] = 0;
          $form['is_active']['#access'] = FALSE;
        }
        // is_active = 0 is also enforced at entity presave (see
        // instructor_companion_civicrm_event_presave) by reading ?propose=1
        // from the current request. That layer is the actual guard against
        // bundles whose form display omits is_active entirely.
        $pay_type = $course_node->get('field_payment_type')->value;
        $pay_amt = $course_node->get('field_payment_amount')->value;
        if ($pay_amt === NULL || $pay_amt === '') {
          $pay_msg = t('to be determined by staff');
        }
        elseif ($pay_type === 'hourly') {
          $pay_msg = t('$@amt per hour', ['@amt' => $pay_amt]);
        }
        else {
          $pay_msg = t('$@amt fixed total', ['@amt' => $pay_amt]);
        }
        $form['agreement'] = [
          '#type' => 'fieldset',
          '#title' => t('Instructor Agreement'),
          '#weight' => 90,
        ];
        $form['agreement']['terms'] = [
          '#markup' => '<p>' . t('By proposing this session, you agree to the standard MakeHaven instructor terms. Your compensation for this specific course is set at <strong>@pay</strong>, subject to final staff review.', ['@pay' => $pay_msg]) . '</p>',
        ];
        $form['agreement']['accept_terms'] = [
          '#type' => 'checkbox',
          '#title' => t('I accept the instructor agreement for this session.'),
          '#required' => TRUE,
        ];
        if (isset($form['field_civi_event_instructor'])) {
          // EntityAutocomplete expects a User entity, not the AccountProxy.
          $user_entity = \Drupal\user\Entity\User::load(\Drupal::currentUser()->id());
          if ($user_entity) {
            $form['field_civi_event_instructor']['widget'][0]['target_id']['#default_value'] = $user_entity;
          }
          // Proposing IS volunteering to teach — the instructor is the
          // proposer, not a field they assign. Hidden with the default set;
          // staff can reassign on the full edit form during review.
          $form['field_civi_event_instructor']['#access'] = FALSE;
        }
        // Staff-grade controls a proposer shouldn't be deciding (2026-08-11
        // coordinator review): publication visibility, registration wiring,
        // event type, badge grants, curation taxonomy, and post-event
        // fields. All stay editable for staff on the normal edit form —
        // this branch only runs for ?propose=1.
        foreach (['is_public', 'is_online_registration'] as $key) {
          if (isset($form[$key])) {
            // Public + online registration are the norm for ticketed
            // workshops; set the value explicitly so the hidden fields
            // can't silently ship an invisible or unregistrable event.
            $form[$key]['widget']['value']['#default_value'] = 1;
            $form[$key]['#access'] = FALSE;
          }
        }
        foreach ([
          'event_type_id',
          'field_civi_event_badges',
          'field_civi_event_tags',
          'field_civi_event_recording',
          'field_civi_event_documents',
        ] as $key) {
          if (isset($form[$key])) {
            $form[$key]['#access'] = FALSE;
          }
        }
        // Keep the course mapping visible for context, but they chose it in
        // the picker — changing it here would just misfile the proposal.
        if (isset($form['field_parent_course'])) {
          $form['field_parent_course']['widget'][0]['target_id']['#attributes']['readonly'] = 'readonly';
          $form['field_parent_course']['widget'][0]['target_id']['#description'] = t('Set from the workshop you picked. Staff can re-file it if needed.');
        }
        // "Primary Staff Contact For Event" is required by field config, but
        // a proposing member has no way to know which staff user to enter —
        // the 2026-08-11 walkthrough showed the form silently refusing to
        // save. Default it (configured user, falling back to the account
        // behind the notification email) and hide it from the proposer;
        // staff can change it during review. With no resolvable default the
        // field stays visible with an explanation instead of a dead end.
        if (isset($form['field_civi_event_staff_contact'])) {
          $staff_default = NULL;
          $configured_uid = (int) \Drupal::config('instructor_companion.settings')->get('proposal_staff_contact_uid');
          if ($configured_uid) {
            $staff_default = \Drupal\user\Entity\User::load($configured_uid);
          }
          if (!$staff_default) {
            $notification_email = \Drupal::config('instructor_companion.settings')->get('notification_email');
            if ($notification_email) {
              $staff_default = user_load_by_mail($notification_email) ?: NULL;
            }
          }
          if ($staff_default) {
            $form['field_civi_event_staff_contact']['widget'][0]['target_id']['#default_value'] = $staff_default;
            $form['field_civi_event_staff_contact']['#access'] = FALSE;
          }
          else {
            $form['field_civi_event_staff_contact']['widget'][0]['target_id']['#description'] = t(
              'Not sure who to enter? Use the staff member who invited you to propose, or ask education@makehaven.org.'
            );
          }
        }
      }

      if ($course_node->hasField('field_course_image') && !$course_node->get('field_course_image')->isEmpty()) {
         if (isset($form['field_civi_event_media_image'])) {
            $media_id = $course_node->get('field_course_image')->target_id;
            $form['field_civi_event_media_image']['widget']['#default_value'] = [$media_id];
         }
      }
    }
  }

  if ($template_id) {
    try {
      \Drupal::service('civicrm')->initialize();
      $template = \civicrm_api3('Event', 'getsingle', ['id' => $template_id]);
      $fields = [
        'title' => $template['title'] ?? '',
        'summary' => $template['summary'] ?? '',
        'description' => $template['description'] ?? '',
        'event_type_id' => $template['event_type_id'] ?? NULL,
        'max_participants' => $template['max_participants'] ?? NULL,
        'is_public' => $template['is_public'] ?? 1,
        'is_online_registration' => $template['is_online_registration'] ?? 1,
      ];
      foreach ($fields as $key => $val) {
        if ($val !== NULL && isset($form[$key])) {
          if (isset($form[$key]['widget'][0]['value'])) {
            $form[$key]['widget'][0]['value']['#default_value'] = $val;
          } else {
            $form[$key]['widget']['#default_value'] = $val;
          }
        }
      }

      // Badge prerequisite warning: load the template event entity to read its
      // configured badges, then warn the proposing instructor if they're missing any.
      $template_event = \Drupal::entityTypeManager()
        ->getStorage('civicrm_event')
        ->load($template_id);
      if ($template_event && $template_event->hasField('field_civi_event_badges') && !$template_event->get('field_civi_event_badges')->isEmpty()) {
        $badge_terms = $template_event->get('field_civi_event_badges')->referencedEntities();
        $missing = instructor_companion_missing_badges($badge_terms, \Drupal::currentUser()->id());
        if (!empty($missing)) {
          instructor_companion_add_badge_warning($form, $missing);
        }
      }
    } catch (\Exception $e) {
      \Drupal::logger('instructor_companion')->error('Error pre-filling event: @msg', ['@msg' => $e->getMessage()]);
    }
  }
}


/**
 * Implements hook_form_alter().
 *
 * Prefills the "Instructor" fieldset of the Workshop Proposal webform
 * (webform_497) from the current user's instructor profile so logged-in
 * instructors don't re-enter bio, rate, name, email, etc. every time.
 *
 * Matches by form_id prefix because the webform is rendered via a webform
 * node, which produces a form ID like
 * `webform_submission_webform_497_node_497_add_form`.
 *
 * Anonymous users see the form unchanged — the traveling-instructor flow
 * still works.
 */
function instructor_companion_form_alter(array &$form, FormStateInterface $form_state, string $form_id) {
  // Delegate to the dedicated CiviCRM event add-form alter for any event
  // bundle. CiviCRM Entity creates a separate form id per bundle
  // (`civicrm_event_ticketed_workshop_add_form`, `civicrm_event_meetup_add_form`,
  // etc.). The named alter at the top of this file only catches
  // `civicrm_event_civicrm_event_add_form`. Broaden the match here so the
  // proposal-flow alter fires regardless of which bundle the instructor
  // ends up on.
  if (preg_match('/^civicrm_event_[a-z0-9_]+_add_form$/', $form_id)
      && $form_id !== 'civicrm_event_civicrm_event_add_form') {
    instructor_companion_form_civicrm_event_civicrm_event_add_form_alter($form, $form_state, $form_id);
    return;
  }

  if (!str_starts_with($form_id, 'webform_submission_webform_497_')
    || !str_ends_with($form_id, '_add_form')) {
    return;
  }
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return;
  }
  $prefill = \Drupal::service('instructor_companion.instructor_profile_resolver')
    ->getPrefillForUser($account);
  if (empty($prefill)) {
    return;
  }

  // Map profile values onto the actual webform element keys. The form_497
  // config uses suffixed names (e.g. your_name_25) from the original build.
  $map = [
    'your_name_25' => $prefill['name'] ?? NULL,
    'e_mail_address_25' => $prefill['email'] ?? NULL,
    'phone_number_25' => $prefill['phone'] ?? NULL,
    'bio_25' => $prefill['bio'] ?? NULL,
    'instructor_compensation_25' => $prefill['compensation'] ?? NULL,
  ];

  if (!isset($form['elements']['fieldset_about_the_instructor'])) {
    return;
  }
  $fieldset = &$form['elements']['fieldset_about_the_instructor'];
  foreach ($map as $key => $value) {
    if ($value === NULL || $value === '') {
      continue;
    }
    if (isset($fieldset[$key])) {
      $fieldset[$key]['#default_value'] = $value;
    }
  }

  // Add a small banner at the top of the fieldset pointing to the profile
  // edit page, so users know they can update their saved data.
  if (!empty($prefill['has_profile'])) {
    $profile_url = \Drupal\Core\Url::fromUserInput('/user/' . $account->id() . '/instructor')->toString();
    $fieldset['saved_profile_banner'] = [
      '#markup' => '<div class="messages messages--status">' .
        t('Using your saved <a href=":url">instructor profile</a>. Update there once and it applies to every proposal.', [':url' => $profile_url]) .
        '</div>',
      '#weight' => -100,
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for civicrm_event_civicrm_event_edit_form.
 *
 * Warns the assigned instructor (or current user editing) if they lack an active
 * badge for any badge this event awards.
 */
function instructor_companion_form_civicrm_event_civicrm_event_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $event = $form_state->getFormObject()->getEntity();
  if (!$event->hasField('field_civi_event_badges') || $event->get('field_civi_event_badges')->isEmpty()) {
    return;
  }

  // Determine whose badge status to check: prefer the assigned instructor,
  // fall back to the current user.
  $uid = \Drupal::currentUser()->id();
  if ($event->hasField('field_civi_event_instructor') && !$event->get('field_civi_event_instructor')->isEmpty()) {
    $uid = (int) $event->get('field_civi_event_instructor')->target_id;
  }

  $badge_terms = $event->get('field_civi_event_badges')->referencedEntities();
  $missing = instructor_companion_missing_badges($badge_terms, $uid);
  if (!empty($missing)) {
    instructor_companion_add_badge_warning($form, $missing);
  }
}

/**
 * AJAX Callback to check for asset conflicts.
 */
function instructor_companion_check_conflicts_ajax(array &$form, FormStateInterface $form_state) {
  $response = new AjaxResponse();
  $start = $form_state->getValue(['start_date', 0, 'value']);
  $end = $form_state->getValue(['end_date', 0, 'value']);
  $asset_ids_str = $form_state->getValue('required_asset_ids');
  if (!$start || !$end || !$asset_ids_str) {
    return $response->addCommand(new HtmlCommand('#asset-conflict-warning', '<em>Enter both start and end dates to check conflicts.</em>'));
  }
  $start_ts = strtotime($start . ' UTC');
  $end_ts = strtotime($end . ' UTC');
  $asset_ids = explode(',', $asset_ids_str);
  $checker = \Drupal::service('makerspace_reservations.conflict_checker');
  $conflicts_found = [];
  foreach ($asset_ids as $nid) {
    $result = $checker->checkConflicts((int)$nid, $start_ts, $end_ts);
    $asset = Node::load($nid);
    $asset_label = $asset ? $asset->label() : "Asset $nid";
    foreach ($result->getDirectConflicts() as $c) {
      $conflicts_found[] = $checker->formatConflictMessage($c, 'direct', $asset_label);
    }
    foreach ($result->getAncestorConflicts() as $c) {
      $conflicts_found[] = $checker->formatConflictMessage($c, 'ancestor', $asset_label);
    }
    foreach ($result->getDescendantConflicts() as $c) {
      $conflicts_found[] = $checker->formatConflictMessage($c, 'descendant', $asset_label);
    }
  }
  if (!empty($conflicts_found)) {
    $output = '<div class="messages messages--warning">';
    $output .= '<strong>Conflict Warning:</strong><ul><li>' . implode('</li><li>', $conflicts_found) . '</li></ul>';
    $output .= '</div>';
  } else {
    $output = '<div class="messages messages--status">No tool conflicts detected for the selected time.</div>';
  }
  return $response->addCommand(new HtmlCommand('#asset-conflict-warning', $output));
}

/**
 * Validates proposal asset conflicts before an instructor can submit.
 *
 * The AJAX callback is helpful for early feedback, but staff should not have to
 * catch collisions manually after the fact. On the instructor proposal path we
 * hard-block submission when required course assets already have conflicting
 * reservations in the requested time slot.
 */
function instructor_companion_validate_proposal_asset_conflicts(array &$form, FormStateInterface $form_state): void {
  $start = $form_state->getValue(['start_date', 0, 'value']);
  $end = $form_state->getValue(['end_date', 0, 'value']);
  $asset_ids_str = (string) $form_state->getValue('required_asset_ids');
  if ($start === NULL || $end === NULL || $asset_ids_str === '') {
    return;
  }

  $start_ts = strtotime($start . ' UTC');
  $end_ts = strtotime($end . ' UTC');
  if (!$start_ts || !$end_ts || $end_ts <= $start_ts) {
    return;
  }

  $checker = \Drupal::service('makerspace_reservations.conflict_checker');
  $asset_ids = array_filter(array_map('intval', explode(',', $asset_ids_str)));
  $messages = [];

  foreach ($asset_ids as $nid) {
    $result = $checker->checkConflicts($nid, $start_ts, $end_ts);
    if (!$result->hasBlockingConflicts(FALSE)) {
      continue;
    }
    $asset = Node::load($nid);
    $asset_label = $asset ? $asset->label() : "Asset $nid";

    foreach ($result->getDirectConflicts() as $conflict) {
      if (!$conflict->isInformational()) {
        $messages[] = $checker->formatConflictMessage($conflict, 'direct', $asset_label);
      }
    }
    foreach ($result->getAncestorConflicts() as $conflict) {
      if (!$conflict->isInformational()) {
        $messages[] = $checker->formatConflictMessage($conflict, 'ancestor', $asset_label);
      }
    }
    foreach ($result->getDescendantConflicts() as $conflict) {
      if (!$conflict->isInformational()) {
        $messages[] = $checker->formatConflictMessage($conflict, 'descendant', $asset_label);
      }
    }
  }

  if ($messages) {
    $form_state->setErrorByName('start_date][0][value', t('This proposed class conflicts with existing reservations on required tools or areas. Adjust the date/time before submitting.'));
    foreach (array_unique($messages) as $message) {
      \Drupal::messenger()->addError(Markup::create($message));
    }
  }
}

/**
 * Implements hook_entity_view_alter() for user entities.
 *
 * Adds a "Become an Instructor" CTA to a member's own profile page when they
 * have indicated teaching availability but don't have an instructor profile yet.
 */
function instructor_companion_user_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display) {
  $current_user = \Drupal::currentUser();

  // Only show on the user's own profile, full view mode.
  if ((int) $entity->id() !== (int) $current_user->id()) {
    return;
  }
  if ($build['#view_mode'] !== 'full') {
    return;
  }
  // Skip if they already have the instructor role.
  if ($current_user->hasRole('instructor')) {
    return;
  }

  // Check main profile for teaching availability.
  $profile_storage = \Drupal::entityTypeManager()->getStorage('profile');
  $main_profiles = $profile_storage->loadByProperties([
    'uid' => $current_user->id(),
    'type' => 'main',
    'status' => 1,
  ]);
  if (empty($main_profiles)) {
    return;
  }

  $main_profile = reset($main_profiles);
  $has_teaching_avail = FALSE;
  foreach ($main_profile->get('field_member_availability') as $item) {
    if (in_array($item->value, ['teach_volunteer', 'teach_paid'], TRUE)) {
      $has_teaching_avail = TRUE;
      break;
    }
  }
  if (!$has_teaching_avail) {
    return;
  }

  // Check whether they've already started the instructor application.
  $instructor_profiles = $profile_storage->loadByProperties([
    'uid' => $current_user->id(),
    'type' => 'instructor',
  ]);
  if (!empty($instructor_profiles)) {
    return;
  }

  // Show the CTA.
  $build['instructor_cta'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['instructor-profile-cta', 'messages', 'messages--status']],
    '#weight' => -50,
    'text' => [
      '#markup' => '<strong>' . t('You indicated interest in teaching — want to make it official?') . '</strong> '
        . '<a href="/become-instructor">' . t('Learn how to become a MakeHaven Instructor') . '</a>.',
    ],
  ];
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function instructor_companion_preprocess_views_view_field(&$variables) {
  $view = $variables['view'];
  $field = $variables['field'];
  $row = $variables['row'];

  if ($view->id() === 'course_library') {
    if ($field->options['id'] === 'rev_per_run') {
      $rev = (float) ($row->node__field_stat_total_rev_field_stat_total_rev_value ?? 0);
      $runs = (int) ($row->node__field_stat_runs_field_stat_runs_value ?? 0);
      $val = $runs > 0 ? $rev / $runs : 0;
      $variables['output'] = Markup::create('$' . number_format($val, 2));
    }
    if ($field->options['id'] === 'rev_per_head') {
      $rev = (float) ($row->node__field_stat_total_rev_field_stat_total_rev_value ?? 0);
      $att = (int) ($row->node__field_stat_total_att_field_stat_total_att_value ?? 0);
      $val = $att > 0 ? $rev / $att : 0;
      $variables['output'] = Markup::create('$' . number_format($val, 2));
    }
  }
}

/**
 * Implements hook_views_pre_view().
 */
function instructor_companion_views_pre_view(\Drupal\views\ViewExecutable $view, $display_id, array &$args) {
  if ($view->id() === 'course_library') {
    // Restrict access to authorized staff only.
    if (!\Drupal::currentUser()->hasPermission('edit all events')) {
      $view->access = FALSE;
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function instructor_companion_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() === 'instructors') {
    _instructor_companion_gate_instructors_directory($view, $query);
    return;
  }

  if ($view->id() !== 'public_course_catalog') {
    return;
  }

  $view->element['#cache']['contexts'][] = 'url.query_args:sort';

  // Clear the default title sort.
  $query->orderby = [];

  $sort_by = \Drupal::request()->query->get('sort', 'frequency');

  if ($sort_by === 'interest') {
    // LEFT JOIN flag_counts so courses with no votes sort last (count = NULL).
    $configuration = [
      'table'      => 'flag_counts',
      'field'      => 'entity_id',
      'left_table' => 'node_field_data',
      'left_field' => 'nid',
      'extra'      => [
        ['field' => 'flag_id',     'value' => 'course_interest'],
        ['field' => 'entity_type', 'value' => 'node'],
      ],
      'type'       => 'LEFT',
    ];
    /** @var \Drupal\views\Plugin\views\join\JoinPluginBase $join */
    $join = \Drupal::service('plugin.manager.views.join')
      ->createInstance('standard', $configuration);
    $alias = $query->addTable('flag_counts', NULL, $join, 'workshop_flag_counts');
    $query->addOrderBy(NULL, "COALESCE($alias.count, 0)", 'DESC', 'workshop_interest_sort');
  }

  // Secondary (or primary for default): most-offered first.
  $runs_alias = $query->ensureTable('node__field_stat_runs');
  $query->addOrderBy($runs_alias, 'field_stat_runs_value', 'DESC', 'workshop_runs_sort');

  // Deterministic third sort by title.
  $query->addOrderBy('node_field_data', 'title', 'ASC', 'workshop_title_sort');
}

/**
 * Gates the public Instructors directory to instructors who actively taught.
 *
 * The directory used to be maintained by hand via the profile
 * field_instructor_status flag. This swaps that manual gate for real
 * teaching activity, reusing the exact same definition the BIPOC instructor
 * KPI uses (Drupal `instructor` role + linked via field_civi_event_instructor
 * + event type Ticketed Workshop/Program) so the public list and the KPI
 * cannot drift. The view's own filters still require a published Instructor
 * profile, so a qualifying instructor with no profile simply does not appear
 * (decision: require both). Window is a rolling 24 months.
 *
 * @see \Drupal\makerspace_dashboard\Service\EventsMembershipDataService::getActiveInstructorDemographics()
 */
function _instructor_companion_gate_instructors_directory(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  $end = new \DateTimeImmutable('now');
  $start = $end->modify('-24 months');

  /** @var \Drupal\makerspace_dashboard\Service\EventsMembershipDataService $service */
  $service = \Drupal::service('makerspace_dashboard.events_membership_data');
  $data = $service->getActiveInstructorDemographics($start, $end);

  $uids = array_values(array_unique(array_filter(array_map(
    static fn (array $row): int => (int) ($row['uid'] ?? 0),
    $data['instructors'] ?? []
  ))));

  if ($uids) {
    // profile.uid is the Instructor profile owner; the KPI service returns
    // the Drupal uid linked as the event instructor — these are the same
    // person's account.
    $query->addWhere(0, 'profile.uid', $uids, 'IN');
  }
  else {
    // No qualifying instructors in the window: show nothing rather than
    // falling through to every published Instructor profile.
    $query->addWhereExpression(0, '1 = 0');
  }

  // The qualifying set derives from CiviCRM event / Drupal user / CiviCRM
  // contact data; invalidate the cached page when any of those change
  // (mirrors the KPI service's own cache tags).
  $view->element['#cache']['tags'][] = 'civicrm_event_list';
  $view->element['#cache']['tags'][] = 'user_list';
  $view->element['#cache']['tags'][] = 'civicrm_contact_list';
}

/**
 * Implements hook_webform_submission_form_alter().
 *
 * The instructor_feedback webform is per-class: it is meaningless without an
 * event context. event_id arrives via `?event_id=NID` (native prepopulate).
 * Here we (a) hard-stop the form when no event is in context, (b) default
 * instructor_uid to the logged-in user, and (c) prefill the actual-attendance
 * textarea from the CiviCRM participant list so the instructor only has to
 * correct walk-ins / no-shows. Direct-DB participant read mirrors
 * xero_bills_sync_get_payee_event_options().
 */
function instructor_companion_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $submission = $form_state->getFormObject()->getEntity();
  if (!$submission instanceof WebformSubmissionInterface
    || $submission->getWebform()->id() !== 'instructor_feedback') {
    return;
  }

  // Resolve the event from the query, an already-set default, or saved data.
  $event_id = (int) (\Drupal::request()->query->get('event_id')
    ?: ($form['elements']['event_id']['#default_value'] ?? 0)
    ?: $submission->getElementData('event_id'));

  $event = $event_id
    ? \Drupal::entityTypeManager()->getStorage('civicrm_event')->load($event_id)
    : NULL;

  if (!$event) {
    // Unusable without a class context — replace the form with guidance
    // rather than collecting an orphaned submission.
    foreach (\Drupal\Core\Render\Element::children($form['elements']) as $key) {
      $form['elements'][$key]['#access'] = FALSE;
    }
    $form['actions']['#access'] = FALSE;
    $form['no_event'] = [
      '#weight' => -100,
      '#markup' => '<div class="messages messages--warning">'
        . t('Open this feedback form from your <a href=":url">Instructor Dashboard</a> (the "Post-class tasks" button on a class) so it can be linked to the right class.', [
          ':url' => \Drupal\Core\Url::fromRoute('instructor_companion.dashboard')->toString(),
        ])
        . '</div>',
    ];
    return;
  }

  $form['elements']['event_id']['#default_value'] = $event_id;

  $account = \Drupal::currentUser();
  if (!$account->isAnonymous() && empty($form['elements']['instructor_uid']['#default_value'])) {
    $form['elements']['instructor_uid']['#default_value'] = (string) $account->id();
  }

  // Prefill actual attendance once (don't clobber an edit in progress).
  $attendance =& $form['elements']['classsection']['attendance_list_actual'];
  if (isset($attendance) && empty($attendance['#default_value']) && $submission->isNew()) {
    $list = instructor_companion_event_attendance_list($event_id);
    if ($list !== '') {
      $attendance['#default_value'] = $list;
    }
  }
}

/**
 * Returns one registered participant per line for an event.
 *
 * Counted, non-test participants joined to their contact display name.
 * Direct DB query (same pattern as the rest of this module's CiviCRM reads).
 */
function instructor_companion_event_attendance_list(int $event_id): string {
  $q = \Drupal::database()->select('civicrm_participant', 'p');
  $q->innerJoin('civicrm_contact', 'c', 'c.id = p.contact_id');
  $q->innerJoin('civicrm_participant_status_type', 'pst', 'pst.id = p.status_id');
  $q->addField('c', 'display_name', 'name');
  $q->condition('p.event_id', $event_id);
  $q->condition('p.is_test', 0);
  $q->condition('pst.is_counted', 1);
  $q->orderBy('c.display_name');
  $names = $q->execute()->fetchCol();
  return $names ? implode("\n", array_filter(array_map('trim', $names))) : '';
}

/**
 * Webforms whose unreviewed→approved transition triggers ProposalProcessor.
 * Each form's "Approve" action does a different downstream thing — see
 * ProposalProcessor::processApproval() for the dispatch.
 */
const INSTRUCTOR_COMPANION_APPROVAL_WEBFORMS = ['webform_497', 'webform_14366'];

/**
 * Implements hook_webform_submission_update().
 *
 * Detects the unreviewed→approved transition and hands off to
 * ProposalProcessor.
 */
function instructor_companion_webform_submission_update(\Drupal\webform\WebformSubmissionInterface $submission) {
  if (!in_array($submission->getWebform()->id(), INSTRUCTOR_COMPANION_APPROVAL_WEBFORMS, TRUE)) {
    return;
  }
  $previous = $submission->original?->getData()['review_status_38'] ?? NULL;
  $current = $submission->getData()['review_status_38'] ?? NULL;
  if ($current === 'approved' && $previous !== 'approved') {
    \Drupal::service('instructor_companion.proposal_processor')
      ->processApproval($submission);
  }
}

/**
 * Implements hook_webform_submission_insert().
 *
 * Handles the rare case of a staffer creating an already-approved
 * submission directly in the admin UI.
 */
function instructor_companion_webform_submission_insert(\Drupal\webform\WebformSubmissionInterface $submission) {
  if (!in_array($submission->getWebform()->id(), INSTRUCTOR_COMPANION_APPROVAL_WEBFORMS, TRUE)) {
    return;
  }
  $current = $submission->getData()['review_status_38'] ?? NULL;
  if ($current === 'approved') {
    \Drupal::service('instructor_companion.proposal_processor')
      ->processApproval($submission);
  }
}
